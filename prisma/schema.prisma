// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")  // migrate/db pull
}

/**
 * === Enums (already exist in DB) ===
 */
enum Platform {
  AMAZON
  EBAY
  GOOGLE
  SHOPIFY
  CUSTOM
}

/**
 * === Tables mapped to your current DB ===
 */

model Campaign {
  id            String   @id @default(cuid())
  name          String
  productName   String
  asin          String // NOT NULL in DB
  imageUrl      String // NOT NULL in DB
  slug          String   @unique
  status        String   @default("active") // DB default is 'active'
  marketplaceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  // Relations
  marketplace       Marketplace?       @relation(fields: [marketplaceId], references: [id])
  reviewTargets     ReviewTarget[]
  reviewSubmissions ReviewSubmission[]
  shortLinks        ShortLink[]
  reviewOpenEvents  ReviewOpenEvent[] // NEW back-relation

  @@index([asin])
}

model Marketplace {
  id         String   @id @default(cuid())
  platform   Platform
  code       String
  tld        String?
  externalId String?
  createdAt  DateTime @default(now())

  campaigns Campaign[]
}

model ReviewTarget {
  id         String   @id @default(cuid())
  campaignId String
  platform   Platform
  asin       String?
  itemId     String?
  placeId    String?
  url        String?
  isPrimary  Boolean  @default(false)
  title      String
  image      String?
  createdAt  DateTime @default(now())

  campaign    Campaign           @relation(fields: [campaignId], references: [id])
  submissions ReviewSubmission[]
}

model ReviewSubmission {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  campaignName   String
  marketplace    Json
  rating         Int
  used7Days      Boolean
  reviewText     String
  orderNumber    String
  email          String?
  marketingOptIn Boolean @default(false)
  productName    String

  // FK relation to ReviewTarget (optional)
  targetId String?
  target   ReviewTarget? @relation(fields: [targetId], references: [id])

  // JSON snapshot column named `target` in the DB
  targetSnapshot Json? @map("target")

  @@unique([campaignId, orderNumber])
}

model ShortLink {
  id         String   @id @default(cuid())
  campaignId String
  slug       String   @unique
  createdAt  DateTime @default(now())

  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  scanEvents ScanEvent[]
}

model ScanEvent {
  id          String   @id @default(cuid())
  shortLinkId String
  userAgent   String?
  ipHash      String?
  createdAt   DateTime @default(now())

  shortLink ShortLink @relation(fields: [shortLinkId], references: [id])
}

/**
 * === NEW: clicks on “Copy & open review page” ===
 */
model ReviewOpenEvent {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  asin        String
  productName String?
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  userAgent   String?
  ipHash      String?

  @@index([asin, createdAt])
}
